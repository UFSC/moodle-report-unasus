CORE_NAME=sistema
DOCKER_VERSION=phpVersion
URL_NAME="local-$CORE_NAME.moodle.ufsc.br"
# Porta do host publicada para o Selenium (a porta interna do container é sempre 4444).
# Mude para evitar conflito ao rodar vários ambientes em paralelo. Default: 4444.
SELENIUM_PORT=4444

# Nº de workers do Behat quando ./run_behat.sh roda com --parallel (sem valor explícito).
# Vazio/ausente = modo sequencial. Trocar o valor força a reinstalação dos sites de teste,
# que é demorada — um site completo por worker.
# BEHAT_PARALLEL=4
