CORE_NAME=sistema
DOCKER_VERSION=phpVersion
URL_NAME="local-$CORE_NAME.moodle.ufsc.br"
# Porta do host publicada para o Selenium (a porta interna do container é sempre 4444).
# Mude para evitar conflito ao rodar vários ambientes em paralelo. Default: 4444.
SELENIUM_PORT=4444

# Nº de workers do Behat quando ./run_behat.sh roda com --parallel (sem valor explícito).
# Vazio/ausente = modo sequencial. Trocar o valor força a reinstalação dos sites de teste,
# que é demorada — um site completo por worker.
# BEHAT_PARALLEL=4

# ---------------------------------------------------------------------------
# Sobreposicoes opcionais
#
# Os scripts derivam nomes e caminhos de CORE_NAME/DOCKER_VERSION, seguindo a convencao
# da maioria dos ambientes. Quando um ambiente foge dela, defina aqui apenas o que muda --
# cada chave abaixo tem como padrao o valor derivado, mostrado ao lado. Os exemplos usam
# os mesmos marcadores do topo deste arquivo, e nao valores de nenhuma maquina.
# ---------------------------------------------------------------------------

# Nome do container do Moodle.            Padrao: moodle-local-$CORE_NAME
# Defina quando o container nao seguir essa ordem no nome.
# CONTAINER_NAME=local-moodle-sistema-000

# Diretorio do site no host, relativo ao DOCKER_COMPOSE_DIR.  Padrao: www/local-$CORE_NAME
# MOODLE_LOCAL_SITE=www/sistema

# Raiz do Moodle dentro do container.     Padrao: /home/moodle/$MOODLE_LOCAL_SITE
# Defina quando a imagem servir de outro lugar.
# MOODLE_ROOT_IN_CONTAINER=/var/www

# Diretorio do docker compose no host.    Padrao: /home/$USER/workspace/docker/$DOCKER_VERSION
# DOCKER_COMPOSE_DIR=/caminho/para/workspace/docker/phpVersion

# Usuario nao-root dentro do container.   Padrao: moodle
# CONTAINER_USER=moodle

# Precisa bater com o phpunit_dataroot do config.php, quando ja' houver um.
# PHPUNIT_DATAROOT=/caminho/para/phpu_moodledata

# Rede do compose (usada pelo Behat).     Padrao: moodle-network-$DOCKER_VERSION
# Defina quando a rede for nomeada por outra coisa -- pela versao do Moodle, por exemplo.
# DOCKER_NETWORK=moodle-network-000

# URL que o navegador do Behat acessa.    Padrao: http://$URL_NAME
# BEHAT_WWWROOT=http://local-sistema.moodle.ufsc.br

# Imagem do Selenium.  Padrao: selenium/standalone-chrome:3.141.59-selenium
# A 3.141 traz o Chrome 75 (2019) e fala o protocolo OSS. O Moodle 4.5 usa o driver W3C
# (OAndreyev\Mink\Driver\WebDriver) e exige Selenium 4 -- sem esta sobreposicao, a sessao
# do navegador nem abre. Ambientes antigos seguem no default.
# SELENIUM_IMAGE=selenium/standalone-chrome:4.27.0
